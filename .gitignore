# ============================================================
# GO BACKEND
# ============================================================

# Go binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib

# Go test binaries
*.test

# Go coverage output
*.out
coverage/
*.cover
.coverage

# Go workspace files
go.work
go.work.sum

# Go build directories
backend/bin/
backend/build/
backend/tmp/

# ============================================================
# DATABASES (SQLite)
# ============================================================

# SQLite database files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# Backend data directory databases
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-shm
backend/data/*.db-wal

# ============================================================
